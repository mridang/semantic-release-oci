{
  "name": "@mridang/semantic-release-oci",
  "version": "1.2.3",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "semver",
    "nodejs",
    "semantic-release",
    "docker",
    "oci"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "Semantic Release plugin that builds, tags, and pushes Docker/OCI images to a container registry",
  "private": false,
  "sideEffects": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/semantic-release-oci.git"
  },
  "homepage": "https://github.com/mridang/semantic-release-oci",
  "bugs": "https://github.com/mridang/semantic-release-oci/issues",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@semantic-release/error": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.1.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/semantic-release__error": "^3.0.3",
    "eslint": "^10.14.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  }
}
